[Unit]
Description=Kubernetes policy evaluation MCP server
After=network.target

[Service]
# Reads the config and the policies from /etc/kube-policy-mcp, and the API
# keys from a file only root and this service can read.
ExecStart=/usr/local/bin/kube-policy-mcp serve \
    --config /etc/kube-policy-mcp/kube-policy-mcp.yaml \
    --http 127.0.0.1:8088 \
    --keys /etc/kube-policy-mcp/keys
Restart=on-failure
User=kube-policy-mcp
Group=kube-policy-mcp
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=1G

[Install]
WantedBy=multi-user.target
